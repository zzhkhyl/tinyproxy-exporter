# Copy to .env and adjust. Every value below is optional; the defaults shown are
# what the two compose files use when nothing is set.
#
#   docker-compose.yml      生产：GHCR 的 latest 镜像
#   docker-compose.dev.yml  开发测试：本机构建镜像
# 两个文件读同一个 .env，变量按用途分组如下。

# ---------------------------------------------------------------------------
# 生产：docker-compose.yml
# ---------------------------------------------------------------------------
# 宿主机绑定地址。默认只绑回环；要对外提供服务时改成 0.0.0.0，
# 并同时收紧 tinyproxy.conf 里的 Allow。
TINYPROXY_BIND=127.0.0.1
EXPORTER_BIND=127.0.0.1
# 挂进容器的配置文件。默认是仓库内那份（Allow 0.0.0.0/0），生产请先收紧或换成自有文件。
TINYPROXY_CONF=./tinyproxy/tinyproxy.conf
# 过滤规则文件（白名单），路径会被挂到容器内 /etc/tinyproxy/filter。见 docs/filter.md。
TINYPROXY_FILTER=./tinyproxy/filter

# ---------------------------------------------------------------------------
# 两个配置共用
# ---------------------------------------------------------------------------
# Host port published for the proxy container.
TINYPROXY_PORT=8888
# Host port published for the exporter container.
EXPORTER_PORT=9119

# ---------------------------------------------------------------------------
# 开发测试：docker-compose.dev.yml（本地构建参数）
# ---------------------------------------------------------------------------
# Injected into the exporter image build with -ldflags.
TINYPROXY_EXPORTER_VERSION=dev
TINYPROXY_EXPORTER_REVISION=unknown

# Build time network overrides. Leave empty unless the official Alpine CDN
# (dl-cdn.alpinelinux.org) or proxy.golang.org are unreachable from the build
# host. Examples:
#   APK_MIRROR=https://mirrors.aliyun.com/alpine
#   GOPROXY=https://mirrors.aliyun.com/goproxy,direct
APK_MIRROR=
GOPROXY=

# ---------------------------------------------------------------------------
# Exporter HTTP server
# ---------------------------------------------------------------------------
EXPORTER_LISTEN_ADDRESS=:9119
EXPORTER_METRICS_PATH=/metrics
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Statistics page channel (StatHost)
# ---------------------------------------------------------------------------
TINYPROXY_STATS_ENABLED=true
# Address of the proxy that serves the statistics page. Inside compose this is
# the service name; outside it is typically http://127.0.0.1:8888.
TINYPROXY_PROXY_URL=http://tinyproxy:8888
# Must match the `StatHost` directive in tinyproxy.conf.
TINYPROXY_STATS_HOST=tinyproxy.stats
TINYPROXY_STATS_INTERVAL=15s
TINYPROXY_STATS_TIMEOUT=5s

# ---------------------------------------------------------------------------
# Log channel
# ---------------------------------------------------------------------------
TINYPROXY_LOG_ENABLED=true
# Must match the `LogFile` directive in tinyproxy.conf / the shared volume.
TINYPROXY_LOG_PATH=/var/log/tinyproxy/tinyproxy.log
TINYPROXY_LOG_POLL_INTERVAL=1s
# false = only count requests made after the exporter started.
TINYPROXY_LOG_FROM_START=false
# Upper bound on distinct host label values in
# tinyproxy_log_requests_by_host_total; the surplus goes to host="__other__".
TINYPROXY_LOG_MAX_HOSTS=500

# ---------------------------------------------------------------------------
# Traffic channel (optional, off by default)
# ---------------------------------------------------------------------------
# Tinyproxy exposes no byte counters. See README.md, "Traffic statistics".
# Leave empty to disable; set to an interface name only if the exporter shares
# tinyproxy's network namespace, otherwise the numbers describe the exporter's
# own namespace.
TINYPROXY_TRAFFIC_INTERFACE=
TINYPROXY_TRAFFIC_INTERVAL=15s
